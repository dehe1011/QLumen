---
const { pathname } = Astro.url;

const navItems = [
    { href: '/', label: 'Home' },
    { href: '/subpages/about', label: 'About' },
    { href: '/subpages/program', label: 'Program' },
    { href: '/subpages/organizers', label: 'Organizers' },
    { href: '/subpages/application', label: 'How to Apply' }
];

const isActive = (href: string) => pathname === href;
---

<nav class="fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="w-full px-4 md:px-8">
        <div class="flex justify-between h-16 md:h-20 items-center">
            <!-- Logo + Title -->
            <a href="/" class="flex items-center space-x-3 group">
                <img src="/images/logo.png" alt="Q-LUMEN Logo" class="h-10 md:h-12 w-auto transition-transform duration-200 group-hover:scale-105" />

                <div class="leading-tight">
                    <span class="block text-[#bd7de8ff] font-bold text-lg md:text-xl tracking-tight"> Q-LUMEN </span>
                    <span class="hidden lg:block text-xs md:text-sm text-gray-600"> The Quantum Leiden Ulm Milan ETH Network </span>
                </div>
            </a>

            <!-- Navigation Links -->
            <div class="hidden md:flex items-center space-x-2">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class={`rounded-full px-4 py-2 text-sm font-medium transition-all duration-200 ${
                                isActive(item.href)
                                    ? 'bg-[#efe1f9ff] text-[#bd7de8ff] shadow-sm'
                                    : 'text-gray-700 hover:bg-[#ffd9bbff]/45 hover:text-[#ff9b3dff]'
                            }`}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>

            <!-- Mobile compact links -->
            <div class="flex md:hidden items-center space-x-2">
                <a
                    href="/subpages/application"
                    class={`rounded-full px-4 py-2 text-sm font-semibold transition ${
                        pathname === '/subpages/application' ? 'bg-[#efe1f9ff] text-[#bd7de8ff]' : 'bg-[#ff9b3dff] text-white hover:bg-[#bd7de8ff]'
                    }`}
                >
                    Apply
                </a>
            </div>
        </div>
    </div>
</nav>
