---
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Supervisors and Organizers – Q-LUMEN</title>

        <style>
            :root {
                --qlumen-purple: #bd7de8ff;
                --qlumen-orange: #ff9b3dff;
                --qlumen-purple-soft: #efe1f9ff;
                --qlumen-orange-soft: #ffd9bbff;
            }

            .qlumen-gradient {
                background: linear-gradient(135deg, var(--qlumen-purple), var(--qlumen-orange));
            }

            .qlumen-soft-gradient {
                background: linear-gradient(135deg, var(--qlumen-purple-soft), var(--qlumen-orange-soft));
            }

            .qlumen-purple-text {
                color: var(--qlumen-purple);
            }

            .qlumen-orange-text {
                color: var(--qlumen-orange);
            }

            .qlumen-card-accent {
                background: linear-gradient(135deg, var(--qlumen-purple), var(--qlumen-orange));
            }
        </style>
    </head>

    <body class="pt-16 md:pt-20 bg-gray-50">
        <Navbar />

        <!-- Hero -->
        <section class="relative pt-32 pb-20 text-white text-center bg-cover bg-center bg-no-repeat" style="background-image: url('/images/Ulm2.jpg');">
            <div class="absolute inset-0 bg-black/55"></div>
            <div class="absolute inset-0 qlumen-gradient opacity-35"></div>

            <div class="relative z-10 max-w-4xl mx-auto px-6">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Supervisors and Organizers</h1>
                <p class="text-base md:text-xl max-w-2xl mx-auto leading-relaxed text-gray-100">
                    Meet the researchers and coordinators behind Q-LUMEN — a team working across quantum information, simulation, computation, and open quantum
                    systems.
                </p>
            </div>
        </section>

        <!-- Supervisors -->
        <section class="max-w-6xl mx-auto py-16 px-6">
            <div class="text-center mb-12">
                <p class="text-sm font-semibold uppercase tracking-wide qlumen-orange-text mb-3">Scientific supervision</p>
                <h2 class="text-3xl font-bold text-gray-900 mb-5">Supervisors</h2>
                <p class="text-gray-700 text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
                    Q-LUMEN projects are guided by researchers from the partner universities. Their expertise spans theoretical and computational quantum
                    information, quantum simulation, superconducting qubits, error correction, nonlocality, and open quantum systems.
                </p>
            </div>

            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Dr. Julius Mildenberger</h3>
                    <p class="text-gray-600 mt-1">Leiden University</p>
                    <p class="mt-4 text-sm text-gray-600 leading-relaxed">Quantum simulation, lattice gauge theories, and quantum error correction.</p>
                </div>

                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Dr. Owidiusz Makuta</h3>
                    <p class="text-gray-600 mt-1">Leiden University</p>
                    <p class="mt-4 text-sm text-gray-600 leading-relaxed">Bell nonlocality, quantum foundations, and quantum error correction.</p>
                </div>

                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Dr. Johannes Knörzer</h3>
                    <p class="text-gray-600 mt-1">ETH Zurich</p>
                    <p class="mt-4 text-sm text-gray-600 leading-relaxed">Quantum computing, superconducting qubits, and many-body systems.</p>
                </div>

                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Dr. Patrick Emonts</h3>
                    <p class="text-gray-600 mt-1">Ulm University</p>
                    <p class="mt-4 text-sm text-gray-600 leading-relaxed">Device certification, Bell nonlocality, and numerical methods.</p>
                </div>

                <a href="/organizers/mirko" class="block">
                    <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100 h-full">
                        <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                        <h3 class="text-xl font-semibold text-gray-900">Dr. Mirko Rossini</h3>
                        <p class="text-gray-600 mt-1">Ulm University</p>
                        <p class="mt-4 text-sm text-gray-600 leading-relaxed">Quantum algorithms, quantum error mitigation, and complex-system modelling.</p>
                    </div>
                </a>

                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Prof. Dario Tamascelli</h3>
                    <p class="text-gray-600 mt-1">University of Milano</p>
                    <p class="mt-4 text-sm text-gray-600 leading-relaxed">Quantum simulation, open quantum systems, and numerical methods.</p>
                </div>
            </div>
        </section>

        <!-- Research Environment -->
        <section class="max-w-5xl mx-auto px-6 pb-8">
            <div class="qlumen-soft-gradient rounded-2xl shadow-md border border-gray-200 p-8 md:p-10">
                <h2 class="text-2xl font-bold mb-5 text-gray-900">A broad view of quantum information</h2>
                <p class="text-lg text-gray-800 leading-relaxed">
                    The supervisor team reflects the diversity of modern quantum science: from fundamental questions about nonlocality and quantum correlations
                    to algorithms, simulations, noisy quantum devices, and open-system dynamics. This gives students the opportunity to encounter different
                    research styles and discover which questions in quantum information excite them most.
                </p>
            </div>
        </section>

        <!-- Organizers and Coordinators -->
        <section class="max-w-3xl mx-auto py-12 px-6">
            <div class="text-center mb-10">
                <p class="text-sm font-semibold uppercase tracking-wide qlumen-purple-text mb-3">Programme coordination</p>
                <h2 class="text-3xl font-bold text-gray-900 mb-5">Organizers &amp; Coordinators</h2>
                <p class="text-gray-700 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
                    The coordination team supports the programme structure, communication, events, and collaboration between the partner institutions.
                </p>
            </div>

            <div class="grid gap-8 sm:grid-cols-2">
                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Miriam Resch</h3>
                    <p class="text-gray-600 mt-1">Ulm University</p>
                </div>

                <div class="bg-white shadow-lg rounded-2xl p-6 text-center hover:shadow-xl transition border border-gray-100">
                    <div class="w-12 h-1 rounded-full qlumen-card-accent mx-auto mb-5"></div>
                    <h3 class="text-xl font-semibold text-gray-900">Dennis Herb</h3>
                    <p class="text-gray-600 mt-1">Ulm University</p>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-gray-900 text-white text-center py-6">
            <p class="mb-2">Q-LUMEN — the Quantum Leiden Ulm Milan ETH Network</p>

            <div class="flex items-center justify-center space-x-3">
                <p>Funded by Global Teaching Lab UGO!</p>
                <img src="/images/Logo_UGo_white.png" alt="Global Teaching Lab UGO!" class="h-11 w-auto" />
            </div>
        </footer>
    </body>
</html>
