      <div class="absolute inset-0 bg-black/50"></div>
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Conference Timetable</h1>
        <p class="text-base md:text-lg max-w-2xl mx-auto px-6">
          Detailed overview of the 4-day schedule for QEpi 2026
        </p>
      </div>
    </section>

    <!-- Timetable -->
