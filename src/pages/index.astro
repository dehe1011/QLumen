---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Q-LUMEN – The Quantum Leiden Ulm Milan ETH Network</title>
        <meta
            name="description"
            content="Q-LUMEN is an international research-based learning programme in quantum information connecting students and supervisors across Europe."
        />

        <style>
            :root {
                --qlumen-purple: #bd7de8ff;
                --qlumen-orange: #ff9b3dff;
                --qlumen-purple-soft: #efe1f9ff;
                --qlumen-orange-soft: #ffd9bbff;
            }

            .qlumen-gradient {
                background: linear-gradient(135deg, var(--qlumen-purple), var(--qlumen-orange));
            }

            .qlumen-soft-gradient {
                background: linear-gradient(135deg, var(--qlumen-purple-soft), var(--qlumen-orange-soft));
            }

            .qlumen-purple-text {
                color: var(--qlumen-purple);
            }

            .qlumen-orange-text {
                color: var(--qlumen-orange);
            }

            .qlumen-purple-border {
                border-color: var(--qlumen-purple);
            }

            .qlumen-card-accent {
                background: linear-gradient(135deg, var(--qlumen-purple), var(--qlumen-orange));
            }
        </style>
    </head>

    <body class="pt-16 md:pt-20 bg-gray-50">
        <Navbar />

        <!-- Hero Section -->
        <section class="relative min-h-[86vh] flex items-center text-white bg-cover bg-center bg-no-repeat" style="background-image: url('/images/Ulm2.jpg');">
            <div class="absolute inset-0 bg-black/60"></div>
            <div class="absolute inset-0 qlumen-gradient opacity-30"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
                <div class="max-w-3xl">
                    <p
                        class="inline-flex items-center rounded-full bg-white/15 backdrop-blur-md border border-white/20 px-4 py-2 text-sm font-medium text-white mb-6"
                    >
                        Q-LUMEN 2026–2027 · Quantum information · International research projects
                    </p>

                    <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight drop-shadow-lg">Q-LUMEN</h1>

                    <p class="text-xl md:text-2xl font-semibold text-gray-100 mb-5">The Quantum Leiden Ulm Milan ETH Network</p>

                    <p class="text-lg md:text-xl text-gray-100 leading-relaxed max-w-2xl mb-8">
                        Work on a real quantum-information research project, collaborate with a student from another European university, and visit partner
                        institutions in Ulm, Leiden, Milan, or Zurich.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4">
                        <a
                            href="/subpages/application"
                            class="inline-flex justify-center items-center rounded-xl qlumen-gradient px-7 py-4 text-white font-semibold shadow-lg hover:shadow-xl hover:scale-[1.02] transition"
                        >
                            Apply Now
                        </a>

                        <a
                            href="/subpages/about"
                            class="inline-flex justify-center items-center rounded-xl bg-white/15 backdrop-blur-md border border-white/25 px-7 py-4 text-white font-semibold hover:bg-white/25 transition"
                        >
                            Learn More
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Intro -->
        <section class="bg-white py-18 md:py-20 border-b border-gray-200">
            <div class="max-w-6xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-wide qlumen-orange-text mb-3">Research-based learning in quantum information</p>

                        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                            A programme for students who want to experience quantum research from the inside.
                        </h2>

                        <p class="text-lg text-gray-700 leading-relaxed mb-6">
                            Q-LUMEN is not a standard lecture course. Students join an international project team, explore a current question in quantum
                            information or quantum technology, and develop their work over several months with scientific supervision.
                        </p>

                        <p class="text-lg text-gray-700 leading-relaxed">
                            The programme combines independent thinking, close mentoring, online collaboration, and in-person meetings at the partner
                            institutions. It is designed for advanced Bachelor and early Master students who are curious about quantum science and want to take
                            their first steps into an international research environment.
                        </p>
                    </div>

                    <div class="qlumen-soft-gradient rounded-3xl shadow-lg border border-gray-200 p-8 md:p-10">
                        <h3 class="text-2xl font-bold text-gray-900 mb-6">At a glance</h3>

                        <div class="space-y-5">
                            <div>
                                <p class="text-sm uppercase tracking-wide font-semibold qlumen-purple-text">Who</p>
                                <p class="text-gray-800">Advanced Bachelor and early Master students</p>
                            </div>

                            <div>
                                <p class="text-sm uppercase tracking-wide font-semibold qlumen-purple-text">What</p>
                                <p class="text-gray-800">Supervised research projects in quantum information</p>
                            </div>

                            <div>
                                <p class="text-sm uppercase tracking-wide font-semibold qlumen-purple-text">Where</p>
                                <p class="text-gray-800">Ulm, Leiden, Milan, ETH Zurich, and online collaboration</p>
                            </div>

                            <div>
                                <p class="text-sm uppercase tracking-wide font-semibold qlumen-purple-text">Application deadline</p>
                                <p class="text-gray-800 font-semibold">15 July 2026</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Navigation Cards + Poster -->
        <section class="bg-gray-50 py-18 md:py-20">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <p class="text-sm font-semibold uppercase tracking-wide qlumen-orange-text mb-3">Explore the programme</p>
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-5">Find your way into Q-LUMEN</h2>
                    <p class="text-lg text-gray-700 leading-relaxed">Learn how the programme works, who supervises the projects, and how to apply.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 items-stretch">
                    <!-- Poster -->
                    <div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-5 flex justify-center items-center">
                        <img src="/images/poster.png" alt="Q-LUMEN programme poster" class="w-full max-w-md h-full object-contain rounded-2xl" />
                    </div>

                    <!-- Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <a
                            href="/subpages/about"
                            class="group bg-white rounded-3xl shadow-md hover:shadow-xl border border-gray-200 p-7 transition flex flex-col justify-between"
                        >
                            <div>
                                <div class="w-12 h-1 rounded-full qlumen-card-accent mb-6"></div>
                                <img src="/icons/circle-question-mark.svg" alt="About icon" class="w-10 h-10 mb-5 opacity-80" />
                                <h3 class="text-xl font-bold text-gray-900 mb-3">About</h3>
                                <p class="text-gray-600 leading-relaxed">
                                    Understand the idea behind Q-LUMEN and what makes research-based learning different.
                                </p>
                            </div>
                            <p class="mt-6 qlumen-purple-text font-semibold group-hover:translate-x-1 transition">Read more →</p>
                        </a>

                        <a
                            href="/subpages/program"
                            class="group bg-white rounded-3xl shadow-md hover:shadow-xl border border-gray-200 p-7 transition flex flex-col justify-between"
                        >
                            <div>
                                <div class="w-12 h-1 rounded-full qlumen-card-accent mb-6"></div>
                                <img src="/icons/calendar-clock.svg" alt="Program icon" class="w-10 h-10 mb-5 opacity-80" />
                                <h3 class="text-xl font-bold text-gray-900 mb-3">Program</h3>
                                <p class="text-gray-600 leading-relaxed">
                                    Follow the timeline from application and kickoff to project work and final presentations.
                                </p>
                            </div>
                            <p class="mt-6 qlumen-purple-text font-semibold group-hover:translate-x-1 transition">View timeline →</p>
                        </a>

                        <a
                            href="/subpages/organizers"
                            class="group bg-white rounded-3xl shadow-md hover:shadow-xl border border-gray-200 p-7 transition flex flex-col justify-between"
                        >
                            <div>
                                <div class="w-12 h-1 rounded-full qlumen-card-accent mb-6"></div>
                                <img src="/icons/atom.svg" alt="Organizers icon" class="w-10 h-10 mb-5 opacity-80" />
                                <h3 class="text-xl font-bold text-gray-900 mb-3">Supervisors</h3>
                                <p class="text-gray-600 leading-relaxed">
                                    Meet the researchers guiding projects across quantum information, simulation, and open systems.
                                </p>
                            </div>
                            <p class="mt-6 qlumen-purple-text font-semibold group-hover:translate-x-1 transition">Meet the team →</p>
                        </a>

                        <a
                            href="/subpages/application"
                            class="group rounded-3xl shadow-md hover:shadow-xl p-7 transition flex flex-col justify-between qlumen-soft-gradient border border-gray-200"
                        >
                            <div>
                                <div class="w-12 h-1 rounded-full qlumen-card-accent mb-6"></div>
                                <img src="/icons/user-pen.svg" alt="Application icon" class="w-10 h-10 mb-5 opacity-80" />
                                <h3 class="text-xl font-bold text-gray-900 mb-3">Application</h3>
                                <p class="text-gray-700 leading-relaxed">See who can apply, which documents are needed, and what happens after submission.</p>
                            </div>
                            <p class="mt-6 qlumen-purple-text font-semibold group-hover:translate-x-1 transition">How to apply →</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Q-LUMEN -->
        <section class="bg-white py-18 md:py-20 border-t border-gray-200">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <p class="text-sm font-semibold uppercase tracking-wide qlumen-orange-text mb-3">Why join?</p>
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-5">
                        Quantum information is collaborative, international, and interdisciplinary.
                    </h2>
                    <p class="text-lg text-gray-700 leading-relaxed">
                        Q-LUMEN gives students a structured way to experience that reality early in their studies.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-gray-50 rounded-3xl shadow-md border border-gray-200 p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Work on an open question</h3>
                        <p class="text-gray-700 leading-relaxed">
                            Move beyond exercises and lectures. You will work on a project where the route is not fully known in advance.
                        </p>
                    </div>

                    <div class="bg-gray-50 rounded-3xl shadow-md border border-gray-200 p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Collaborate across Europe</h3>
                        <p class="text-gray-700 leading-relaxed">
                            Join forces with a student from another university and learn how scientific collaboration works across distance and institutions.
                        </p>
                    </div>

                    <div class="bg-gray-50 rounded-3xl shadow-md border border-gray-200 p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Build research confidence</h3>
                        <p class="text-gray-700 leading-relaxed">
                            Discuss ideas with supervisors, present your progress, receive feedback, and turn a scientific question into a coherent result.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Supervisors + CTA -->
        <section class="bg-gray-50 py-18 md:py-20 border-t border-gray-200">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-12 items-stretch">
                    <!-- Supervisors -->
                    <div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-8 md:p-10">
                        <p class="text-sm font-semibold uppercase tracking-wide qlumen-orange-text mb-3">Supervision</p>
                        <h2 class="text-3xl font-bold text-gray-900 mb-8">Guided by researchers from four partner universities</h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-7">
                            <div>
                                <p class="font-semibold text-gray-900">Dr. Julius Mildenberger</p>
                                <p class="text-gray-600 text-sm">Leiden University</p>
                                <p class="text-gray-500 text-sm mt-1">Quantum simulation, lattice gauge theories, error correction</p>
                            </div>

                            <div>
                                <p class="font-semibold text-gray-900">Dr. Owidiusz Makuta</p>
                                <p class="text-gray-600 text-sm">Leiden University</p>
                                <p class="text-gray-500 text-sm mt-1">Bell nonlocality, quantum foundations, error correction</p>
                            </div>

                            <div>
                                <p class="font-semibold text-gray-900">Dr. Johannes Knörzer</p>
                                <p class="text-gray-600 text-sm">ETH Zurich</p>
                                <p class="text-gray-500 text-sm mt-1">Quantum computing, superconducting qubits, many-body systems</p>
                            </div>

                            <div>
                                <p class="font-semibold text-gray-900">Dr. Patrick Emonts</p>
                                <p class="text-gray-600 text-sm">Ulm University</p>
                                <p class="text-gray-500 text-sm mt-1">Device certification, Bell nonlocality, numerical methods</p>
                            </div>

                            <div>
                                <p class="font-semibold text-gray-900">Dr. Mirko Rossini</p>
                                <p class="text-gray-600 text-sm">Ulm University</p>
                                <p class="text-gray-500 text-sm mt-1">Quantum algorithms, error mitigation, complex-system modelling</p>
                            </div>

                            <div>
                                <p class="font-semibold text-gray-900">Prof. Dario Tamascelli</p>
                                <p class="text-gray-600 text-sm">University of Milano</p>
                                <p class="text-gray-500 text-sm mt-1">Open quantum systems, quantum simulation, numerical methods</p>
                            </div>
                        </div>

                        <div class="mt-8">
                            <a href="/subpages/organizers" class="qlumen-purple-text font-semibold hover:underline"> See supervisors and organizers → </a>
                        </div>
                    </div>

                    <!-- CTA -->
                    <div class="rounded-3xl shadow-lg qlumen-gradient p-8 md:p-10 text-white flex flex-col justify-center">
                        <p class="text-sm font-semibold uppercase tracking-wide text-white/80 mb-3">Applications</p>

                        <h2 class="text-3xl md:text-4xl font-bold mb-6">Interested in joining the next Q-LUMEN cohort?</h2>

                        <p class="text-lg text-white/90 leading-relaxed mb-8">
                            Applications for Q-LUMEN 2026–2027 are open to motivated students with an interest in quantum information, quantum technologies, and
                            research-based learning.
                        </p>

                        <div class="space-y-3 mb-8">
                            <p class="text-white/95">
                                <strong>Deadline:</strong> 15 July 2026
                            </p>
                            <p class="text-white/95">
                                <strong>Kickoff:</strong> 13.-15. September 2026 in Ulm
                            </p>
                            <p class="text-white/95">
                                <strong>Cohort size:</strong> approximately 14 students
                            </p>
                        </div>

                        <a
                            href="/subpages/application"
                            class="inline-flex justify-center items-center rounded-xl bg-white text-gray-900 font-semibold px-7 py-4 shadow-md hover:bg-gray-100 transition w-fit"
                        >
                            Submit Your Application
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-gray-900 text-white text-center py-6">
            <p class="mb-2">Q-LUMEN — the Quantum Leiden Ulm Milan ETH Network</p>

            <div class="flex items-center justify-center space-x-3">
                <p>Funded by Global Teaching Lab UGO!</p>
                <img src="/images/Logo_UGo_white.png" alt="Global Teaching Lab UGO!" class="h-11 w-auto" />
            </div>
        </footer>
    </body>
</html>
