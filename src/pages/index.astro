---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Q-LUMEN – the Quantum Leiden Ulm Milan ETH Network</title>
        <meta name="description" content="Q-LUMEN – the Quantum Leiden Ulm Milan ETH Network." />
    </head>
    <body class="pt-16 md:pt-20">
        <Navbar />

        <!-- Hero Section with embedded intro -->
        <section
            class="relative flex flex-col justify-end items-center text-center text-white bg-cover bg-center bg-no-repeat min-h-[80vh]"
            style="background-image: url('/images/Ulm2.jpg');"
        >
            <div class="absolute inset-0 bg-black/50"></div>

            <!--  First -->
            <div class="relative z-10 max-w-3xl px-6 pb-24">
                <h1 class="text-4xl md:text-6xl font-bold mb-4 drop-shadow-lg">Q-LUMEN</h1>
                <p class="text-lg md:text-xl mb-6 text-gray-100">
                    <strong>The Quantum Leiden Ulm Milan ETH Network</strong>
                    <br />
                    <span class="text-gray-200">Supported by Global Teaching Labs</span>
                </p>
                <a
                    href="/subpages/application"
                    class="inline-block bg-white text-indigo-600 font-semibold px-6 py-3 rounded-lg shadow-md hover:bg-gray-200 transition"
                >
                    Apply Now
                </a>
            </div>

            <!-- Second -->
            <div class="relative z-10 bg-black/40 backdrop-blur-sm text-white text-center px-8 py-10 rounded-2xl shadow-lg max-w-3xl mb-20">
                <h2 class="text-3xl font-bold mb-4">Welcome to Q-LUMEN</h2>
                <p class="text-lg leading-relaxed text-gray-100">
                    Q-LUMEN is an international, research-oriented teaching format in quantum information, connecting master’s students with ETH Zurich, Leiden
                    University, Ulm University, and the University of Milano.
                </p>
            </div>
        </section>

        <!-- Navigation Grid -->
        <section class="bg-gray-100 py-16">
            <div class="max-w-7xl mx-auto px-6">
                <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Learn more about the project</h2>

                <!-- Two-column layout -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
                    <!-- left -->
                    <div class="flex justify-center h-full">
                        <img src="/images/poster.png" alt="Q-LUMEN conference poster" class="w-full max-w-md h-full object-contain shadow-xl bg-white" />
                    </div>

                    <!-- right -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-center">
                        <!-- About -->
                        <a
                            href="/subpages/about"
                            class="bg-white rounded-2xl shadow-md hover:shadow-xl p-8 transition flex flex-col items-center justify-center"
                        >
                            <img src="/icons/circle-question-mark.svg" alt="About icon" class="w-12 h-12 mb-4 opacity-80" />
                            <h3 class="text-xl font-semibold mb-2">About</h3>
                            <p class="text-gray-600">Learn about Q-LUMEN.</p>
                        </a>

                        <!--  Organizers -->
                        <a
                            href="/subpages/organizers"
                            class="bg-white rounded-2xl shadow-md hover:shadow-xl p-8 transition flex flex-col items-center justify-center"
                        >
                            <img src="/icons/atom.svg" alt="Organizers icon" class="w-12 h-12 mb-4 opacity-80" />
                            <h3 class="text-xl font-semibold mb-2">Organizers</h3>
                            <p class="text-gray-600">Meet the organizers and supervisors.</p>
                        </a>

                        <!--  Program -->
                        <a
                            href="/subpages/program"
                            class="bg-white rounded-2xl shadow-md hover:shadow-xl p-8 transition flex flex-col items-center justify-center"
                        >
                            <img src="/icons/calendar-clock.svg" alt="Program icon" class="w-12 h-12 mb-4 opacity-80" />
                            <h3 class="text-xl font-semibold mb-2">Program</h3>
                            <p class="text-gray-600">Scientific program and networking activities.</p>
                        </a>

                        <!--  Contact -->
                        <a
                            href="mailto:dennis.herb@uni-ulm.de"
                            class="bg-white rounded-2xl shadow-md hover:shadow-xl p-8 transition flex flex-col items-center justify-center"
                        >
                            <img src="/icons/user-pen.svg" alt="Contact icon" class="w-12 h-12 mb-4 opacity-80" />
                            <h3 class="text-xl font-semibold mb-2">Contact</h3>
                            <p class="text-gray-600">Contact the organizing committee.</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-20 border-t border-gray-200">
            <div class="max-w-7xl mx-auto px-6">
                <!-- Two cards side by side -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                    <!-- LEFT CARD — Supervisors & Organizers -->
                    <div class="bg-gray-50 rounded-2xl shadow-lg p-12 transition-all duration-300">
                        <h3 class="text-center text-3xl font-semibold text-indigo-700 mb-12">Supervisors &amp; Organizers</h3>

                        <!-- Supervisors -->
                        <div class="mb-12">
                            <h4 class="text-xl font-semibold text-gray-900 mb-8 text-center">Supervisors</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 items-start text-left">
                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dr. Julius Mildenberger</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Leiden University</p>
                                    <p class="text-gray-500 text-sm leading-snug">Quantum Simulation, Lattice Gauge Theories, Quantum Error Correction</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dr. Owidiusz Makuta</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Leiden University</p>
                                    <p class="text-gray-500 text-sm leading-snug">Bell Nonlocality, Quantum Error Correction</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dr. Johannes Knörzer</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">ETH Zurich</p>
                                    <p class="text-gray-500 text-sm leading-snug">Quantum Computing, Superconducting Qubits, Many-Body Systems</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dr. Patrick Emonts</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Ulm University</p>
                                    <p class="text-gray-500 text-sm leading-snug">Device Certification, Bell Nonlocality, Numerical Methods</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dr. Mirko Rossini</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Ulm University</p>
                                    <p class="text-gray-500 text-sm leading-snug">Quantum Algorithms, Quantum Error Mitigation, Complex System Modelling</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Prof. Dario Tamascelli</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">University of Milano</p>
                                    <p class="text-gray-500 text-sm leading-snug">Quantum Simulation, Open Quantum Systems, Numerical Methods</p>
                                </div>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="border-t border-gray-200 mb-10"></div>

                        <!-- Organizers and Coordinators -->
                        <div>
                            <h4 class="text-xl font-semibold text-gray-900 mb-8 text-center">Organizers &amp; Coordinators</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 items-start text-left">
                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Miriam Resch</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Ulm University</p>
                                </div>

                                <div class="space-y-[3px]">
                                    <p class="text-lg font-semibold text-gray-900">Dennis Herb</p>
                                    <p class="text-gray-600 text-[0.95rem] leading-snug">Ulm University</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT CARD — Join Q-LUMEN -->
                    <div class="bg-gray-50 rounded-2xl shadow-lg p-10 flex flex-col justify-center text-center">
                        <h2 class="text-3xl font-bold mb-6">Join Q-LUMEN</h2>

                        <p class="text-lg text-gray-700 mb-10 leading-relaxed">Check how to apply and submit your application.</p>

                        <a
                            href="/subpages/application"
                            class="inline-block bg-indigo-600 text-white font-semibold px-10 py-4 rounded-xl shadow-md hover:bg-indigo-700 transition w-fit mx-auto"
                        >
                            Submit Your Application
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-gray-900 text-white text-center py-6">
            <p class="mb-2">Q-LUMEN - the Quantum Leiden Ulm Milan ETH Network</p>

            <div class="flex items-center justify-center space-x-3">
                <p>Funded by – Global Teaching Lab UGO!</p>
                <img src="/images/Logo_UGo_white.png" alt="Global Teaching Lab UGO!" class="h-11 w-auto" />
            </div>
        </footer>
    </body>
</html>
